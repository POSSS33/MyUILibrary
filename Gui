--// MiniMobileUI - Simple Small Mobile UI (by soooooo G)

local MiniUI = {}

function MiniUI:CreateWindow(config)
    local TitleText = config.Title or "Mini UI"
    local ThemeColor = config.Color or Color3.fromRGB(0, 255, 130)

    local gui = Instance.new("ScreenGui", game.CoreGui)
    gui.ResetOnSpawn = false
    gui.Name = "MiniMobileUI"

    --// MAIN WINDOW (เล็กมาก)
    local Main = Instance.new("Frame", gui)
    Main.Size = UDim2.new(0, 230, 0, 300)
    Main.Position = UDim2.new(0.5, -115, 0.5, -150)
    Main.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
    Main.BorderSizePixel = 0
    Main.Active = true
    Main.Draggable = true

    local Stroke = Instance.new("UIStroke", Main)
    Stroke.Color = ThemeColor
    Stroke.Thickness = 1

    --// TOPBAR
    local Top = Instance.new("Frame", Main)
    Top.Size = UDim2.new(1, 0, 0, 32)
    Top.BackgroundColor3 = Color3.fromRGB(24, 24, 24)
    Top.BorderSizePixel = 0

    local Title = Instance.new("TextLabel", Top)
    Title.Size = UDim2.new(1, -10, 1, 0)
    Title.Position = UDim2.new(0, 10, 0, 0)
    Title.Text = TitleText
    Title.BackgroundTransparency = 1
    Title.Font = Enum.Font.GothamBold
    Title.TextColor3 = ThemeColor
    Title.TextSize = 15
    Title.TextXAlignment = Enum.TextXAlignment.Left

    --// CONTAINER
    local Container = Instance.new("Frame", Main)
    Container.Size = UDim2.new(1, 0, 1, -32)
    Container.Position = UDim2.new(0, 0, 0, 32)
    Container.BackgroundTransparency = 1

    local List = Instance.new("UIListLayout", Container)
    List.Padding = UDim.new(0, 6)
    List.SortOrder = Enum.SortOrder.LayoutOrder

    --// BUTTON FUNCTION
    function MiniUI:Button(Text, Callback)
        Callback = Callback or function() end

        local Btn = Instance.new("TextButton", Container)
        Btn.Size = UDim2.new(1, -16, 0, 32)
        Btn.Position = UDim2.new(0, 8, 0, 0)
        Btn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        Btn.BorderSizePixel = 0
        Btn.Text = Text
        Btn.TextColor3 = ThemeColor
        Btn.Font = Enum.Font.Gotham
        Btn.TextSize = 14

        local S = Instance.new("UIStroke", Btn)
        S.Color = ThemeColor
        S.Thickness = 1

        Btn.MouseButton1Click:Connect(function()
            pcall(Callback)
        end)
    end

    return MiniUI
end

return MiniUI
